# ============================================================
# uEmuera iOS —— .gitignore
# 放到 Unity 工程根目录，命名 .gitignore
# ============================================================

# ---- Unity 工程本体（不必提交）----
Library/
Temp/
Obj/
obj/
Logs/
UserSettings/
*.csproj
*.sln
*.user
*.unityproj
*.pidb
*.booproj
*.svd
crashlytics-build.properties

# ---- ★ 只拦截 Unity 导出的 Xcode 工程里的大文件 ★ ----
# 注意：绝对不要用裸的 "*.a" 规则！
# Assets/unity.webp/Plugins/iOS/*.a 是项目必需的 iOS 原生静态库
# （libwebp / libwebpdecoder / libwebpdemux，共约 5MB），
# 一旦被忽略，Xcode 链接阶段会报 WebP 符号未定义。
# 真正需要排除的只有导出目录下这两个超大文件：
Libraries/libiPhone-lib.a
Libraries/libil2cpp.a
Libraries/libGameAssembly.a
/Unity-iPhone.xcodeproj/
/Libraries/
/Data/
/DerivedData/

# ---- 构建产物 ----
build/
dist/
Payload/
Build/
*.tipa
*.ipa
*.app
*.log
build.log

# ---- macOS / Xcode ----
.DS_Store
xcuserdata/
*.xcuserdatad/
*.xcuserstate
*.xcscmblueprint
*.moved-aside

# ---- 临时文件 ----
*.tmp
*.bak
*~

# ============================================================
# 显式放行：这些是构建必需的，切勿加入忽视列表
# ============================================================
!Assets/unity.webp/Plugins/**
!Assets/unity.webp/Plugins/iOS/*.a
!Assets/Plugins/**
!Classes/
!Data/
